{
  "name": "questorylabs",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm run dev:all",
    "dev:all": "pnpm -r --parallel --filter @questorylabs/api --filter @questorylabs/web run dev",
    "dev:apiscrobbler": "pnpm --filter @questorylabs/api run dev",
    "dev:api": "pnpm --filter @questorylabs/api run dev:http",
    "dev:web": "pnpm --filter @questorylabs/web run dev",
    "build": "pnpm db:generate && pnpm --filter @questorylabs/db run build && pnpm --filter @questorylabs/shared run build && pnpm --filter @questorylabs/ui run build && pnpm --filter @questorylabs/api --filter @questorylabs/web run build",
    "db:schema": "node scripts/sync-prisma-schema.mjs",
    "db:generate": "pnpm db:schema && node scripts/prisma-generate-safe.mjs",
    "db:push": "node scripts/migrate-identity-accounts.mjs && pnpm db:schema && pnpm --filter @questorylabs/db exec prisma db push --accept-data-loss",
    "db:migrate": "node scripts/migrate-identity-accounts.mjs && pnpm db:schema && pnpm --filter @questorylabs/db exec prisma migrate dev",
    "setup": "pnpm install && pnpm --filter @questorylabs/shared build && pnpm --filter @questorylabs/db run build && pnpm db:generate && pnpm db:push",
    "docker:infra": "node scripts/docker-profile.mjs infra",
    "docker:selfhosted": "node scripts/docker-profile.mjs selfhosted",
    "docker:selfhosted-full": "node scripts/docker-profile.mjs selfhosted-full",
    "docker:prod": "node scripts/docker-profile.mjs production",
    "docker:up": "pnpm run docker:selfhosted-full",
    "docker:down": "docker compose --profile selfhosted --profile selfhosted-full --profile production --profile infra down",
    "docker:publish": "node scripts/docker-publish.mjs",
    "docker:build": "node scripts/docker-publish.mjs --no-push",
    "test": "pnpm run test:scripts && pnpm -r --if-present test",
    "test:scripts": "vitest run --config vitest.scripts.config.mjs",
    "check": "node scripts/check-local.mjs",
    "check:fast": "node scripts/check-local.mjs --skip-e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.4",
      "fast-uri": "3.1.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "deepmerge-ts": "8.0.2",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "multer": "2.4.0",
      "mysql2": "3.23.1",
      "qs": "6.16.0",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "adm-zip": "0.6.1"
    },
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "sharp",
      "msgpackr-extract",
      "esbuild",
      "@swc/core"
    ]
  }
}
