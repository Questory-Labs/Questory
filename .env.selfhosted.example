# Self-hosted lite — SQLite volume, no Redis, inline sync
# Deploy: pnpm docker:selfhosted
APP_MODE=selfhosted

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:/data/questorylabs.db"

REDIS_URL=
USE_INLINE_SYNC=true

# Required: strong secret (min 16 chars) and Steam Web API key
SESSION_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Set these to your public (or LAN) origins when not using localhost
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

API_PORT=4000
# COOKIE_DOMAIN=

# Recommended for a private instance (17-digit SteamIDs, comma-separated)
# Empty = anyone who can reach the app may sign in via Steam
# ALLOWED_STEAM_IDS=76561198000000000

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Docker Hub images (defaults shown)
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest
# PULL_POLICY=missing
