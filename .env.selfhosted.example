# Self-hosted lite — SQLite volume, no Redis, inline sync
# Deploy: pnpm docker:selfhosted
APP_MODE=selfhosted

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:/data/questorylabs.db"

REDIS_URL=
USE_INLINE_SYNC=true

# Required: strong secret (min 16 chars) and Steam Web API key
SESSION_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Set these to your public (or LAN) origins when not using localhost
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional music (compose --profile music). Shares DATABASE_URL with API.
# Rebuild web after changing NEXT_PUBLIC_* .
# Ingest token: mint in Settings → Profile (not env).
NEXT_PUBLIC_ENABLE_MUSIC=false
NEXT_PUBLIC_MUSIC_URL=http://localhost:4010
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)

# Optional watch / movies (compose --profile watch). Same DB / session as API.
# Rebuild web after NEXT_PUBLIC_* changes. Share SESSION_SECRET with API.
NEXT_PUBLIC_ENABLE_WATCH=false
NEXT_PUBLIC_WATCH_URL=http://localhost:4020
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4020/v1/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4020/v1/anilist/callback
# Webhook auth: mint watch_webhook ApiKey in Settings → Watch (header x-watch-webhook-secret).

API_PORT=4000
# COOKIE_DOMAIN=

# Recommended for a private instance (17-digit SteamIDs, comma-separated)
# Empty = anyone who can reach the app may sign in via Steam
# ALLOWED_STEAM_IDS=76561198000000000

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Docker Hub images (defaults shown)
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest
# PULL_POLICY=missing
