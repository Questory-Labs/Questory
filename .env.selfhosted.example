# Self-hosted lite — SQLite volume, no Redis, inline sync
# Deploy: pnpm docker:selfhosted
APP_MODE=selfhosted

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:/data/questorylabs.db"

REDIS_URL=
USE_INLINE_SYNC=true

# Required: strong secret (min 16 chars) and Steam Web API key
SESSION_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Set these to your public (or LAN) origins when not using localhost
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional music (API module: /v1/music/*; ListenBrainz at /1/*).
# Rebuild web after changing NEXT_PUBLIC_* .
# Nav: flag=true AND API /health reports music.enabled.
# Ingest token: mint in Settings → Profile (not env).
NEXT_PUBLIC_ENABLE_MUSIC=false
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)

# Optional watch / movies (API module: /v1/watch/*; webhooks at /webhooks/*).
# Rebuild web after NEXT_PUBLIC_* changes.
NEXT_PUBLIC_ENABLE_WATCH=false
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4000/v1/watch/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4000/v1/watch/anilist/callback
# Webhook auth: mint watch_webhook ApiKey in Settings → Watch (header x-watch-webhook-secret).

API_PORT=4000
# COOKIE_DOMAIN=

# Recommended for a private instance (17-digit SteamIDs, comma-separated)
# Empty = anyone who can reach the app may sign in via Steam
# ADMIN_EMAILS=you@example.com
# ALLOWED_STEAM_IDS=76561198000000000
# TRUST_PROXY=true

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional in-process cron (runs inside the API). Off by default.
# CRON_ENABLED=false
# CRON_SECRET=replace-with-a-long-random-cron-secret
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *

# Optional image overrides when not building from source
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest
# PULL_POLICY=missing
