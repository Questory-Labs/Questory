{
  "name": "@questorylabs/api",
  "version": "0.0.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "predev": "node ../../scripts/sync-prisma-schema.mjs && node ../../scripts/prisma-generate-safe.mjs client",
    "dev": "node scripts/dev.mjs",
    "dev:http": "nest start --watch",
    "dev:scrobbler": "nest start --watch --entryFile scrobbler-worker",
    "prebuild": "node ../../scripts/sync-prisma-schema.mjs && node ../../scripts/prisma-generate-safe.mjs client",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:scrobbler": "node dist/scrobbler-worker.js",
    "prisma:generate": "pnpm --filter @questorylabs/db run generate",
    "prisma:migrate": "pnpm --filter @questorylabs/db run migrate",
    "prisma:push": "pnpm --filter @questorylabs/db run push",
    "pretest": "node ../../scripts/sync-prisma-schema.mjs && node ../../scripts/prisma-generate-safe.mjs client",
    "test": "vitest run"
  },
  "dependencies": {
    "@crawlee/cheerio": "^3.17.0",
    "@crawlee/core": "^3.17.0",
    "@crawlee/memory-storage": "^3.17.0",
    "@crawlee/playwright": "^3.17.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@questorylabs/db": "workspace:*",
    "@questorylabs/qhttp": "^0.2.1",
    "@questorylabs/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.44.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cron": "^3.5.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "ioredis": "^5.6.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@swc/core": "^1.15.46",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "typescript": "^5.8.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
