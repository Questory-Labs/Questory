{
  "name": "@questorylabs/api",
  "version": "0.0.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "predev": "node ../../scripts/sync-prisma-schema.mjs && node ../../scripts/prisma-generate-safe.mjs client",
    "dev": "nest start --watch",
    "prebuild": "node ../../scripts/sync-prisma-schema.mjs && node ../../scripts/prisma-generate-safe.mjs client",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "pnpm --filter @questorylabs/db run generate",
    "prisma:migrate": "pnpm --filter @questorylabs/db run migrate",
    "prisma:push": "pnpm --filter @questorylabs/db run push",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@questorylabs/db": "workspace:*",
    "@questorylabs/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^5.6.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@swc/core": "^1.15.46",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "typescript": "^5.8.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
