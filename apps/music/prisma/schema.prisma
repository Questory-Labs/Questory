generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model MusicUser {
  id              String    @id @default(cuid())
  username        String    @unique
  /** SHA-256 hex of the ListenBrainz ingest token */
  ingestTokenHash String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listens         Listen[]
  hourBuckets     ListenHourBucket[]
  playingNow      PlayingNow?
}

model Artist {
  id                 String    @id @default(cuid())
  name               String
  nameNormalized     String
  mbid               String?
  imageUrl           String?
  metadataSyncedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tracks             Track[]
  releases           Release[]
  genres             ArtistGenre[]

  @@index([nameNormalized])
  @@index([mbid])
}

model Release {
  id                 String    @id @default(cuid())
  title              String
  titleNormalized    String
  artistId           String?
  mbid               String?
  releaseMbid        String?
  year               Int?
  imageUrl           String?
  metadataSyncedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  artist             Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  tracks             Track[]

  @@index([titleNormalized])
  @@index([mbid])
  @@index([artistId])
}

model Track {
  id                 String    @id @default(cuid())
  title              String
  titleNormalized    String
  artistId           String
  releaseId          String?
  recordingMbid      String?
  trackMbid          String?
  isrc               String?
  spotifyId          String?
  durationMs         Int?
  metadataSyncedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  artist             Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  release            Release?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  genres             TrackGenre[]
  listens            Listen[]
  playingNow         PlayingNow[]
  enrichmentJobs     EnrichmentJob[]

  @@index([titleNormalized])
  @@index([artistId])
  @@index([releaseId])
  @@index([recordingMbid])
  @@index([spotifyId])
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  tracks    TrackGenre[]
  artists   ArtistGenre[]
}

model TrackGenre {
  trackId String
  genreId String
  source  String   @default("payload_tag")
  weight  Float    @default(1)

  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId, source])
  @@index([genreId])
}

model ArtistGenre {
  artistId String
  genreId  String
  source   String  @default("musicbrainz")
  weight   Float   @default(1)

  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId, source])
  @@index([genreId])
}

model Listen {
  id               String   @id @default(cuid())
  userId           String
  trackId          String
  listenedAt       DateTime
  listenType       String   @default("single")
  mediaPlayer      String?
  submissionClient String?
  musicService     String?
  rawPayload       String?
  createdAt        DateTime @default(now())

  user  MusicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, listenedAt])
  @@index([userId, listenedAt])
  @@index([trackId])
}

model ListenHourBucket {
  id          String   @id @default(cuid())
  userId      String
  hourStart   DateTime
  listenCount Int      @default(0)

  user MusicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hourStart])
  @@index([userId, hourStart])
}

model PlayingNow {
  userId    String   @id
  trackId   String
  updatedAt DateTime @updatedAt

  user  MusicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model EnrichmentJob {
  id          String    @id @default(cuid())
  trackId     String
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([trackId])
}
