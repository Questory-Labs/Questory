{
  "name": "@questorylabs/db",
  "version": "0.0.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node ../../scripts/sync-prisma-schema.mjs && prisma generate",
    "push": "node ../../scripts/sync-prisma-schema.mjs && prisma db push",
    "migrate": "node ../../scripts/sync-prisma-schema.mjs && prisma migrate dev"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
