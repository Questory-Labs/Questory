# Questory Labs — pick a deployment mode, then copy that template to `.env`
#
#   cp .env.local.example .env              # local development (SQLite)
#   cp .env.selfhosted.example .env         # minimal Docker (SQLite, no Redis)
#   cp .env.selfhosted-full.example .env    # Docker with Postgres + Redis
#   cp .env.production.example .env         # cloud / multi-user
#
# Then set at least: SESSION_SECRET, STEAM_API_KEY
# Optional private instance: ALLOWED_STEAM_IDS=76561198...,76561198...
#
# See README.md and docs/self-hosting.md

APP_MODE=local
