# Full stack + QEngine — copy to .env then fill secrets
#   cp .env.enterprise.example .env
#   docker compose -f docker-compose.enterprise.yml --env-file .env up -d --build
#
# QEngine binary images: personal / noncommercial only.

APP_MODE=selfhosted-full
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:questorylabs@postgres:5432/questorylabs
REDIS_URL=redis://redis:6379
USE_INLINE_SYNC=false

# Required
SESSION_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=
CRON_SECRET=replace-with-a-long-random-cron-secret

# Origins (change for LAN / public hosts)
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=
# ALLOWED_STEAM_IDS=
# ADMIN_EMAILS=

# Feature flags (all on for this stack; rebuild web after changing NEXT_PUBLIC_*)
NEXT_PUBLIC_ENABLE_MUSIC=true
NEXT_PUBLIC_ENABLE_WATCH=true
NEXT_PUBLIC_ENABLE_READ=true
ENTERPRISE=true
NEXT_PUBLIC_ENTERPRISE_URL=http://localhost:4030

# Optional integrations
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4000/v1/watch/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4000/v1/watch/anilist/callback
ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Images
DOCKERHUB_NAMESPACE=santoshpanna
IMAGE_TAG=latest
PULL_POLICY=missing
QENGINE_IMAGE=santoshpanna/questorylabs-qengine:latest
# QENGINE_IMAGE=ghcr.io/questory-labs/questorylabs-qengine:latest
QENGINE_PULL_POLICY=always

# Ports
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
ENTERPRISE_PORT=4030
OTEL_API_PORT=4040
OTEL_HTTP_PORT=4318

# QEngine
ENTERPRISE_STORE=postgres
ENTERPRISE_ML=on
ENTERPRISE_LLM=on
ENTERPRISE_OLLAMA_URL=http://host.docker.internal:11434
ENTERPRISE_LLM_MODEL=llama3.1:8b
ENTERPRISE_EMBED_MODEL=nomic-embed-text
ENTERPRISE_LLM_PULL=on
ENTERPRISE_STAGE_TIMEOUT_MS=30000
ENTERPRISE_EMBED_PROVIDER=auto
ENTERPRISE_WORLD=on
# ENTERPRISE_BRAVE_API_KEY=
ENTERPRISE_BRAVE_BUDGET=1500
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=qengine

# Cron (in-process inside API)
CRON_ENABLED=true
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *
