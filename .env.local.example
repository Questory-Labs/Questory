# Local development — SQLite, no Redis, inline sync
APP_MODE=local

DATABASE_PROVIDER=sqlite
# Prefer an absolute file: path so Nest/Prisma always hit the same DB
DATABASE_URL="file:./dev.db"

REDIS_URL=
USE_INLINE_SYNC=false

SESSION_SECRET=change-me-to-a-long-random-string
STEAM_API_KEY=

# Realm must be a prefix of return_to (both should be the API origin for local)
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave unset for local (browsers reject Domain=localhost)
# COOKIE_DOMAIN=

# Optional: restrict who can sign in (17-digit SteamIDs, comma-separated)
# ALLOWED_STEAM_IDS=

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional music service (pnpm dev:music). Shares DATABASE_URL with the API.
# Nav shows only when flag=true AND ${NEXT_PUBLIC_MUSIC_URL}/health ok.
# Ingest token is NOT an env var — mint in Settings → Profile after login.
NEXT_PUBLIC_ENABLE_MUSIC=false
NEXT_PUBLIC_MUSIC_URL=http://localhost:4010
MUSIC_PORT=4010
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)

# Optional watch / movies (pnpm dev:watch). Same DATABASE_URL / User as Steam+music.
# Nav shows only when flag=true AND ${NEXT_PUBLIC_WATCH_URL}/health ok.
# Share SESSION_SECRET with the API so the browser session cookie works on watch.
NEXT_PUBLIC_ENABLE_WATCH=false
NEXT_PUBLIC_WATCH_URL=http://localhost:4020
WATCH_PORT=4020

# Trakt OAuth (create app at https://trakt.tv/oauth/applications)
# Redirect URI must match exactly what you register on Trakt.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4020/v1/trakt/callback

# TMDB — title metadata / posters (https://www.themoviedb.org/settings/api)
# TMDB_API_KEY=

# AniList OAuth (optional anime list sync)
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4020/v1/anilist/callback

# Plex/Jellyfin webhooks: mint a watch_webhook ApiKey in Settings → Watch (or Profile).
# Send as header x-watch-webhook-secret — not a global env secret.
# Letterboxd CSV import uses the logged-in session (no env secret).

# Optional daily sync scheduler (pnpm dev:cron). Off by default.
CRON_ENABLED=false
CRON_SECRET=local-dev-cron-secret
API_INTERNAL_URL=http://localhost:4000
WATCH_INTERNAL_URL=http://localhost:4020
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *
