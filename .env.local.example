# Local development — Postgres + pgvector by default (no Redis)
# Start DB: docker compose --profile infra up -d postgres
APP_MODE=local

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:questorylabs@localhost:5432/questorylabs

REDIS_URL=
USE_INLINE_SYNC=false

SESSION_SECRET=change-me-to-a-long-random-string
STEAM_API_KEY=

# Email login: comma-separated emails that receive isAdmin on signup/login
# ADMIN_EMAILS=you@example.com

# Behind a reverse proxy that sets X-Forwarded-For (Docker / production)
# TRUST_PROXY=true

# Extra disposable domains for signup blocklist (comma-separated)
# AUTH_BLOCKED_EMAIL_DOMAINS=

# Optional challenge HMAC secret (defaults to SESSION_SECRET)
# AUTH_CHALLENGE_SECRET=

# Realm must be a prefix of return_to (Steam link-only from Connections)
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave unset for local (browsers reject Domain=localhost)
# COOKIE_DOMAIN=
# COOKIE_SECURE=   # optional override; default auto-detects from Origin/WEB_ORIGIN

# Optional: restrict which SteamIDs can be linked (17-digit, comma-separated)
# ALLOWED_STEAM_IDS=

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional music (served by API under /v1/music/*; ListenBrainz at /1/*).
# Nav shows only when flag=true AND API /health reports music.enabled.
# Ingest token is NOT an env var — mint in Settings → Profile after login.
NEXT_PUBLIC_ENABLE_MUSIC=false
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)

# Optional watch / movies (served by API under /v1/watch/*; webhooks at /webhooks/*).
# Nav shows only when flag=true AND API /health reports watch.enabled.
NEXT_PUBLIC_ENABLE_WATCH=false

# Optional read / manga (served by API under /v1/read/*).
# Nav shows only when flag=true AND API /health reports read.enabled.
# Uses the same AniList OAuth as Watch (anime → Watch, manga → Read).
NEXT_PUBLIC_ENABLE_READ=false

# Trakt OAuth (create app at https://trakt.tv/oauth/applications)
# Redirect URI must match exactly what you register on Trakt.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4000/v1/watch/trakt/callback

# TMDB — title metadata / posters (https://www.themoviedb.org/settings/api)
# TMDB_API_KEY=

# AniList OAuth (optional anime + manga list sync)
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4000/v1/watch/anilist/callback
# (Read can also use /v1/read/anilist/callback if registered as an extra redirect URI.)

# MyAnimeList OAuth (optional anime + manga list sync)
# MAL_CLIENT_ID=
# MAL_CLIENT_SECRET=
# MAL_REDIRECT_URI=http://localhost:4000/v1/watch/mal/callback

# Shikimori OAuth (optional anime + manga list sync)
# SHIKIMORI_CLIENT_ID=
# SHIKIMORI_CLIENT_SECRET=
# SHIKIMORI_REDIRECT_URI=http://localhost:4000/v1/watch/shikimori/callback

# Bangumi OAuth (optional anime + manga collection sync)
# BANGUMI_CLIENT_ID=
# BANGUMI_CLIENT_SECRET=
# BANGUMI_REDIRECT_URI=http://localhost:4000/v1/watch/bangumi/callback

# Kitsu uses email/password at connect time in Settings (no env vars).

# Plex/Jellyfin webhooks: mint a watch_webhook ApiKey in Settings → Watch (or Profile).
# Send as header x-watch-webhook-secret — not a global env secret.
# Letterboxd CSV import uses the logged-in session (no env secret).

# Optional in-process cron (runs inside the API). Off by default.
# In-process cron is on by default; set false|FALSE|0 to disable
# CRON_ENABLED=false
CRON_SECRET=local-dev-cron-secret
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *
# CRON_CATALOG_SCHEDULE=0 4 * * *

# QEngine (when private Rust tree is present). Opt-in flag required.
# Web calls the Axum service directly (session cookie; SESSION_SECRET must match).
ENTERPRISE=false
NEXT_PUBLIC_ENTERPRISE_URL=http://localhost:4030
# Copy full block from enterprise/.env.example into enterprise/.env (and/or here);
# the service also reads repo-root .env for DATABASE_URL / SESSION_SECRET.
# ENTERPRISE_PORT=4030
# ENTERPRISE_STORE=postgres
# ENTERPRISE_DATA_DIR=./data
# OTEL_API_PORT=4040
# OTEL_HTTP_PORT=4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=qengine
