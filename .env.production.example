# Production — Postgres + Redis, hardened public HTTPS / multi-user instance
# Deploy: pnpm docker:prod -- --build
APP_MODE=production

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:CHANGE_ME@postgres:5432/questorylabs

REDIS_URL=redis://redis:6379
USE_INLINE_SYNC=false

# Required: strong secret (min 16 chars) — never use placeholders
SESSION_SECRET=
STEAM_API_KEY=

# Public HTTPS origins (Steam OpenID: realm must be a prefix of return URL; both API origin)
STEAM_REALM=https://api.example.com
STEAM_RETURN_URL=https://api.example.com/auth/steam/callback
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Optional music (API module: /v1/music/*; ListenBrainz at /1/*).
# Rebuild web after NEXT_PUBLIC_* changes. Ingest token: Settings → Profile.
# Nav: flag=true AND API /health reports music.enabled.
NEXT_PUBLIC_ENABLE_MUSIC=false
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)
# LASTFM_API_KEY=
# LASTFM_API_SECRET=
# LASTFM_REDIRECT_URI=https://api.example.com/v1/music/scrobbler/lastfm/callback
# Compose runs Last.fm polls in the `scrobbler` worker, not the API process.

# Optional watch / movies (API module: /v1/watch/*; webhooks at /webhooks/*).
NEXT_PUBLIC_ENABLE_WATCH=false
NEXT_PUBLIC_ENABLE_READ=false
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=https://api.example.com/v1/watch/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=https://api.example.com/v1/watch/anilist/callback
# Webhook auth: mint watch_webhook ApiKey in Settings → Watch (header x-watch-webhook-secret).

API_PORT=4000
# Share session cookie across app/api subdomains when needed
COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true   # optional; default auto-detects from Origin/WEB_ORIGIN

# Leave empty for open multi-user signup; set to lock the instance down
# ADMIN_EMAILS=
# ALLOWED_STEAM_IDS=
# TRUST_PROXY=true

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# In-process cron (runs inside the API)
# In-process cron is on by default; set false|FALSE|0 to disable (e.g. external-only HTTP cron)
# CRON_ENABLED=false
CRON_SECRET=
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *
# CRON_PRICE_SCHEDULE=0 5 * * *

# Optional image overrides when not building from source
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest          # stable channel (same as :stable)
# IMAGE_TAG=rc              # latest release candidate
# IMAGE_TAG=canary          # latest canary from main
# IMAGE_TAG=v1.2.3          # pin a specific stable version
# IMAGE_TAG=v1.3.0-rc.1     # pin a release candidate
# IMAGE_TAG=v1.3.0-canary.5 # pin a canary build
# PULL_POLICY=missing        # optional: skip registry pull on compose up (default is always)
