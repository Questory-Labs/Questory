# Production (cloud / multi-user) — Postgres + Redis, public HTTPS URLs
# Deploy: pnpm docker:prod
APP_MODE=production

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:CHANGE_ME@postgres:5432/questorylabs

REDIS_URL=redis://redis:6379
USE_INLINE_SYNC=false

# Required: strong secret (min 16 chars) — never use placeholders
SESSION_SECRET=
STEAM_API_KEY=

# Public HTTPS origins (Steam OpenID: realm must be a prefix of return URL; both API origin)
STEAM_REALM=https://api.example.com
STEAM_RETURN_URL=https://api.example.com/auth/steam/callback
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

API_PORT=4000
# Share session cookie across app/api subdomains when needed
COOKIE_DOMAIN=.example.com

# Leave empty for open multi-user signup; set to lock the instance down
# ALLOWED_STEAM_IDS=

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Daily price/stats sync + stuck-job recovery (cron Docker service)
CRON_ENABLED=false
CRON_SECRET=
API_INTERNAL_URL=http://api:4000
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *

# Docker Hub images (defaults shown)
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest
# PULL_POLICY=always
