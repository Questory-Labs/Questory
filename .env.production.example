# Production (cloud / multi-user) — Postgres + Redis, public HTTPS URLs
# Deploy: pnpm docker:prod
APP_MODE=production

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:CHANGE_ME@postgres:5432/questorylabs

REDIS_URL=redis://redis:6379
USE_INLINE_SYNC=false

# Required: strong secret (min 16 chars) — never use placeholders
SESSION_SECRET=
STEAM_API_KEY=

# Public HTTPS origins (Steam OpenID: realm must be a prefix of return URL; both API origin)
STEAM_REALM=https://api.example.com
STEAM_RETURN_URL=https://api.example.com/auth/steam/callback
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Optional music (compose --profile music-pg). Shares DATABASE_URL with API.
# Rebuild web after NEXT_PUBLIC_* changes. Ingest token: Settings → Profile.
NEXT_PUBLIC_ENABLE_MUSIC=false
NEXT_PUBLIC_MUSIC_URL=https://music.example.com
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)

# Optional watch / movies (compose --profile watch-pg). Share SESSION_SECRET + COOKIE_DOMAIN.
NEXT_PUBLIC_ENABLE_WATCH=false
NEXT_PUBLIC_WATCH_URL=https://watch.example.com
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=https://watch.example.com/v1/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=https://watch.example.com/v1/anilist/callback
# Webhook auth: mint watch_webhook ApiKey in Settings → Watch (header x-watch-webhook-secret).

API_PORT=4000
# Share session cookie across app/api/music/watch subdomains when needed
COOKIE_DOMAIN=.example.com

# Leave empty for open multi-user signup; set to lock the instance down
# ADMIN_EMAILS=
# ALLOWED_STEAM_IDS=
# TRUST_PROXY=true

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Daily price/stats sync + stuck-job recovery (cron Docker service)
CRON_ENABLED=false
CRON_SECRET=
API_INTERNAL_URL=http://api:4000
WATCH_INTERNAL_URL=http://watch:4020
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *

# Docker Hub images (defaults shown)
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest
# PULL_POLICY=always
