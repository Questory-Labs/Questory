# Self-hosted full — Postgres + Redis + BullMQ
# Deploy: pnpm docker:selfhosted-full
APP_MODE=selfhosted-full

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://questorylabs:questorylabs@postgres:5432/questorylabs

REDIS_URL=redis://redis:6379
USE_INLINE_SYNC=false

# Required: strong secret (min 16 chars) and Steam Web API key
SESSION_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Set these to your public (or LAN) origins when not using localhost
STEAM_REALM=http://localhost:4000
STEAM_RETURN_URL=http://localhost:4000/auth/steam/callback
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional music (API module: /v1/music/*; ListenBrainz at /1/*).
# Rebuild web after NEXT_PUBLIC_* changes. Ingest token: Settings → Profile.
# Nav: flag=true AND API /health reports music.enabled.
NEXT_PUBLIC_ENABLE_MUSIC=false
# MUSICBRAINZ_USER_AGENT=QuestoryLabs-Music/0.1 (you@example.com)
# LASTFM_API_KEY=
# LASTFM_API_SECRET=
# LASTFM_REDIRECT_URI=http://localhost:4000/v1/music/scrobbler/lastfm/callback
# Full/production compose runs Last.fm polls in the `scrobbler` worker, not the API process.

# Optional watch / movies (API module: /v1/watch/*; webhooks at /webhooks/*).
NEXT_PUBLIC_ENABLE_WATCH=false
NEXT_PUBLIC_ENABLE_READ=false
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=http://localhost:4000/v1/watch/trakt/callback
# TMDB_API_KEY=
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:4000/v1/watch/anilist/callback
# Webhook auth: mint watch_webhook ApiKey in Settings → Watch (header x-watch-webhook-secret).

API_PORT=4000
# COOKIE_DOMAIN=
# COOKIE_SECURE=   # optional override; default auto-detects from Origin/WEB_ORIGIN

# Recommended for a private instance (17-digit SteamIDs, comma-separated)
# Empty = anyone who can reach the app may sign in via Steam
# ALLOWED_STEAM_IDS=76561198000000000

ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# In-process cron (runs inside the API)
# In-process cron is on by default; set false|FALSE|0 to disable
# CRON_ENABLED=false
CRON_SECRET=replace-with-a-long-random-cron-secret
# CRON_DAILY_SCHEDULE=0 3 * * *
# CRON_RECOVERY_SCHEDULE=*/15 * * * *
# CRON_WATCH_SCHEDULE=0 */6 * * *
# CRON_PRICE_SCHEDULE=0 5 * * *

# Optional image overrides when not building from source
# DOCKERHUB_NAMESPACE=santoshpanna
# IMAGE_TAG=latest          # stable channel (same as :stable)
# IMAGE_TAG=rc              # latest release candidate
# IMAGE_TAG=canary          # latest canary from main
# IMAGE_TAG=v1.2.3          # pin a specific stable version
# IMAGE_TAG=v1.3.0-rc.1     # pin a release candidate
# IMAGE_TAG=v1.3.0-canary.5 # pin a canary build
# PULL_POLICY=missing        # optional: skip registry pull on compose up (default is always)
